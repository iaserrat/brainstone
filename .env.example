# Copy to .env and fill in. Every value stays in the environment or a secret
# store; nothing here is read by the runtime from a file named .env.

# SQLite or PostgreSQL. SQLite: DATABASE_URL=sqlite://./data/runtime.db
# (create the parent directory first). URL-encode special characters.
DATABASE_URL=replace-with-a-database-url

# anthropic (default), openai, bedrock, bedrock-mantle, or bedrock-openai.
# See docs/operations.md.
# MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
# Bedrock only: region, and a Bedrock model ID above (for example
# us.anthropic.claude-sonnet-4-6). Leave ANTHROPIC_API_KEY unset to sign with
# the AWS credential chain instead of a Bedrock API key.
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL_BEDROCK_RUNTIME=https://vpce-....bedrock-runtime.us-east-1.vpce.amazonaws.com
# OPENAI_API_KEY is required when MODEL_PROVIDER=openai.
# OPENAI_API_KEY=
# Optional secondary model a turn fails over to when the primary is
# unavailable, rate limited, timing out, or unreachable, on any provider above.
# Each FALLBACK_ variable means what its unprefixed primary variable means;
# FALLBACK_MAX_TOKENS and FALLBACK_MODEL_EFFORT default to the primary's.
# See docs/operations.md. Example: a GPT model on Bedrock, signed with IAM.
# FALLBACK_MODEL=us.openai.gpt-5.6-sol
# FALLBACK_MODEL_PROVIDER=bedrock-openai
# FALLBACK_AWS_REGION=us-east-1
# FALLBACK_ANTHROPIC_API_KEY=
# FALLBACK_OPENAI_API_KEY=
# FALLBACK_AWS_ENDPOINT_URL_BEDROCK_RUNTIME=
# FALLBACK_MAX_TOKENS=8192
# FALLBACK_MODEL_EFFORT=high
ANTHROPIC_MAX_TOKENS=8192
MODEL_EFFORT=high
# Automatic prompt caching (5-minute TTL) on Messages requests. Default off.
# PROMPT_CACHE=true
# No response-count limit by default. Set a positive integer to impose one.
# MAX_TURNS=unlimited

# Automatic compaction starts at 90% of the model context window.
MODEL_CONTEXT_WINDOW=200000
# Optionally compact earlier. Values above 90% are clamped to that safe limit.
# AUTO_COMPACT_TOKEN_LIMIT=180000

# Let the model write a text file (Markdown, CSV, JSON) for the reply to attach.
# FILE_TOOL=true

# Add MCP credentials referenced by mcp.toml, for example:
# MCP_REMOTE_TOKEN=replace-with-an-mcp-token

WORKER_ID=brainstone-1
RUST_LOG=info
